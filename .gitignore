# Only the paths listed here are published; everything else in the folder stays local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/THIRD_PARTY_NOTICES.md
!/LICENSES/
!/TRACEABILITY.md
!/requirements.txt
!/run_all.py
!/build_report.py
!/src/
!/tests/
!/data/
!/results/
!/figures/
!/report/
!/references/

# Python caches
__pycache__/
*.pyc

# Regenerated by `python run_all.py`: the train/test split and the fitted pipelines
data/processed/

# Output of tests/make_synthetic.py (smoke-test data, never used in the report)
synthetic/

# references/: only the bibliography, the reference data and the verified records
/references/*
!/references/annotated_bibliography.md
!/references/references.json
!/references/verified/

# Word and PDF files are build outputs or personal copies, wherever they are saved
*.docx
*.doc
*.pdf
*.tmp
~$*
report/draft.docx.sha256

# Review records kept locally
results/rubric_review_round*.json

# Credentials and editor or operating-system files
.env
kaggle.json
.kaggle/
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
